# Copy to .env and fill in. Without MUBIT_API_KEY the server runs a mock model,
# so you can test the whole flow offline.

# Mubit key (starts with mbt_): app.mubit.ai → Get started / Mubit keys.
MUBIT_API_KEY=

# Which provider Mubit forwards to: anthropic (Claude) or openai.
MUBIT_PROVIDER=anthropic

# Model ID, exactly as you'd send it to the provider. On the starter credit it must be
# a model the credit serves; if not, the error message lists the ones it does.
MUBIT_MODEL=claude-haiku-4-5

# Use the base URL your Mubit console's Connect page shows.
MUBIT_BASE_URL=https://api.mubit.ai

# Provider prices in USD per million tokens, for the ledger (defaults: 1 / 5).
# PRICE_IN_PER_M=1
# PRICE_OUT_PER_M=5

# Adapter estimates until you have real Try models numbers.
# ADAPTER_COST_RATIO=0.05
# ADAPTER_LATENCY_MS=200

# PORT=8787
